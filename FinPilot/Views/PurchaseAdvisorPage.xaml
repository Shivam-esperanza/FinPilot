<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinPilot.ViewModels"
             xmlns:models="clr-namespace:FinPilot.Models"
             x:Class="FinPilot.Views.PurchaseAdvisorPage"
             x:DataType="viewmodels:PurchaseAdvisorViewModel"
             Title="Smart Purchase Advisor"
             BackgroundColor="#FFFFFF">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" MaximumWidthRequest="550" HorizontalOptions="Center">

            <Label Text="Smart Purchase Advisor" FontSize="24" FontAttributes="Bold" TextColor="#512BD4"/>

            <!-- Input Form Box -->
            <Border StrokeShape="RoundRectangle 8" Padding="15" BackgroundColor="#F8FAFC">
                <VerticalStackLayout Spacing="10">
                    <Label Text="What product are you planning to buy?" FontAttributes="Bold" FontSize="14" TextColor="#1E293B"/>
                    <Entry Placeholder="e.g. MacBook Air M4" Text="{Binding ProductName, Mode=TwoWay}" TextColor="#1E293B" PlaceholderColor="#64748B" BackgroundColor="#F1F5F9"/>

                    <Label Text="Product Price (₹)" FontAttributes="Bold" FontSize="14" TextColor="#1E293B"/>
                    <Entry Placeholder="e.g. 120000" Keyboard="Numeric" Text="{Binding ProductPriceText, Mode=TwoWay}" TextColor="#1E293B" PlaceholderColor="#64748B" BackgroundColor="#F1F5F9"/>

                    <Label Text="Preferred EMI Tenure (Months)" FontAttributes="Bold" FontSize="14" TextColor="#1E293B"/>
                    <Entry Placeholder="e.g. 12" Keyboard="Numeric" Text="{Binding TenureText, Mode=TwoWay}" TextColor="#1E293B" PlaceholderColor="#64748B" BackgroundColor="#F1F5F9"/>

                    <Button Text="Analyze Best Financing Path" Command="{Binding AnalyzePurchaseCommand}" BackgroundColor="#512BD4" TextColor="#FFFFFF" HeightRequest="48" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>

            <!-- Error Banner -->
            <Label Text="{Binding ErrorMessage}" TextColor="#EF4444" FontSize="14" HorizontalOptions="Center"/>

            <!-- AI Advisory Banner -->
            <Border StrokeShape="RoundRectangle 8" Padding="15" BackgroundColor="#F0FDF4" Stroke="#10B981"
                    IsVisible="{Binding AiExplanation, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="AI Assistant Advisory Explanation" FontAttributes="Bold" FontSize="14" TextColor="#065F46"/>
                    <Label Text="{Binding AiExplanation}" FontSize="13" TextColor="#047857"/>
                </VerticalStackLayout>
            </Border>

            <!-- Results Output -->
            <Label Text="Ranked Financing Recommendations" FontSize="18" FontAttributes="Bold" TextColor="#1E293B"/>
            <CollectionView ItemsSource="{Binding Results}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AdvisorOption">
                        <Border StrokeShape="RoundRectangle 12" Margin="0,0,0,15" Padding="15" Stroke="#10B981" BackgroundColor="#F1F5F9">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,*">
                                    <Label Grid.Column="0" Text="{Binding BankName}" FontAttributes="Bold" FontSize="18" TextColor="#3B82F6"/>
                                    <Label Grid.Column="1" Text="{Binding MatchScore, StringFormat='{0:F0}% Match'}" FontAttributes="Bold" HorizontalOptions="End" TextColor="#10B981"/>
                                </Grid>

                                <Label Text="{Binding RecommendationReason}" FontSize="13" TextColor="#475569"/>

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,5,0,0">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Monthly EMI:" FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding MonthlyEmi, StringFormat='₹{0:N2}'}" FontAttributes="Bold" HorizontalOptions="End"/>

                                    <Label Grid.Row="1" Grid.Column="0" Text="Net Out-of-Pocket Cost:" FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding NetEffectiveCost, StringFormat='₹{0:N2}'}" FontAttributes="Bold" HorizontalOptions="End" TextColor="#EF4444"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
