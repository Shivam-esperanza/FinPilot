<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FinPilot.Models"
             x:Class="FinPilot.Views.CreditCardManagerPage"
             Title="Credit Card Manager"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" MaximumWidthRequest="500" HorizontalOptions="CenterAndExpand">

            <Label Text="Your Active Credit Lines" FontSize="20" FontAttributes="Bold" Margin="0,0,0,10"
                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"/>

            <!-- CollectionView to iterate and build cards dynamically -->
            <CollectionView x:Name="CardsCollection" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CreditCard">
                        <Border StrokeShape="RoundRectangle 12" Margin="0,0,0,15" Padding="20" 
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#151F32}">
                            <VerticalStackLayout Spacing="12">

                                <!-- Card Header details -->
                                <Grid ColumnDefinitions="*,*">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding CardName}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}"/>
                                        <Label Text="{Binding Bank.Name}" FontSize="12" TextColor="Gray"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding LastFourDigits, StringFormat='•••• {0}'}" 
                                           HorizontalOptions="End" VerticalOptions="Start" FontSize="14" TextColor="Gray"/>
                                </Grid>

                                <!-- Visual Utilization Indicator Line -->
                                <ProgressBar Progress="{Binding CreditUtilizationPercentage, Converter={StaticResource InvertedBoolConverter}}" 
                                             ProgressColor="{AppThemeBinding Light=#3B82F6, Dark=#60A5FA}" HeightRequest="6"/>

                                <!-- Financial Metrics Sub-Grid -->
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Outstanding Balance" FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding OutstandingAmount, StringFormat='₹{0:N2}'}" FontAttributes="Bold" HorizontalOptions="End" TextColor="#EF4444"/>

                                    <Label Grid.Row="1" Grid.Column="0" Text="Available Credit Limit" FontSize="12" TextColor="Gray"/>
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding AvailableLimit, StringFormat='₹{0:N2}'}" FontAttributes="Bold" HorizontalOptions="End" TextColor="#10B981"/>
                                </Grid>

                                <!-- Footer Billing Cycles -->
                                <Border StrokeShape="RoundRectangle 4" Padding="10" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}">
                                    <Grid ColumnDefinitions="*,*">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="Utilization:" FontSize="11" TextColor="Gray"/>
                                            <Label Text="{Binding CreditUtilizationPercentage, StringFormat='{0:F1}%'}" FontSize="11" FontAttributes="Bold"/>
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding DueDate, StringFormat='Due: {0:dd MMM yyyy}'}" FontSize="11" HorizontalOptions="End" TextColor="#F59E0B"/>
                                    </Grid>
                                </Border>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
