<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinPilot.ViewModels"
             xmlns:models="clr-namespace:FinPilot.Models"
             x:Class="FinPilot.Views.LoansPage"
             x:DataType="viewmodels:LoansViewModel"
             Title="Active Loans"
             BackgroundColor="#FFFFFF">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" MaximumWidthRequest="550" HorizontalOptions="Center">

            <Label Text="Active Loans and Liabilities" FontSize="24" FontAttributes="Bold" TextColor="#512BD4"/>

            <!-- Add Loan Form -->
            <Border StrokeShape="RoundRectangle 8" Padding="15" BackgroundColor="#F8FAFC">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Add New Loan" FontAttributes="Bold" FontSize="16" TextColor="#1E293B"/>

                    <Picker Title="Select Lending Bank"
                            ItemsSource="{Binding Banks}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedBank, Mode=TwoWay}"
                            TitleColor="#64748B"
                            TextColor="#1E293B"
                            BackgroundColor="#F1F5F9"/>

                    <Entry Placeholder="Loan Account Number" Text="{Binding LoanNumber, Mode=TwoWay}" TextColor="#1E293B" PlaceholderColor="#64748B" BackgroundColor="#F1F5F9"/>
                    <Entry Placeholder="Loan Type (Personal, Home, Car, Edu)" Text="{Binding LoanType, Mode=TwoWay}" TextColor="#1E293B" PlaceholderColor="#64748B" BackgroundColor="#F1F5F9"/>
                    <Entry Placeholder="Total Loan Amount (₹)" Text="{Binding TotalAmountText, Mode=TwoWay}" Keyboard="Numeric" TextColor="#1E293B" PlaceholderColor="#64748B" BackgroundColor="#F1F5F9"/>
                    <Entry Placeholder="Remaining Principal (₹)" Text="{Binding RemainingPrincipalText, Mode=TwoWay}" Keyboard="Numeric" TextColor="#1E293B" PlaceholderColor="#64748B" BackgroundColor="#F1F5F9"/>
                    <Entry Placeholder="Monthly EMI (₹)" Text="{Binding MonthlyEmiText, Mode=TwoWay}" Keyboard="Numeric" TextColor="#1E293B" PlaceholderColor="#64748B" BackgroundColor="#F1F5F9"/>
                    <Entry Placeholder="Interest Rate APR (%)" Text="{Binding InterestRateText, Mode=TwoWay}" Keyboard="Numeric" TextColor="#1E293B" PlaceholderColor="#64748B" BackgroundColor="#F1F5F9"/>

                    <Label Text="Next Payment Due Date" FontSize="12" TextColor="#64748B"/>
                    <DatePicker Date="{Binding NextEmiDate, Mode=TwoWay}" TextColor="#1E293B" BackgroundColor="#F1F5F9"/>

                    <Button Text="Add Loan" Command="{Binding AddLoanCommand}" BackgroundColor="#512BD4" TextColor="#FFFFFF"/>
                </VerticalStackLayout>
            </Border>

            <!-- Error Banner -->
            <Label Text="{Binding ErrorMessage}" TextColor="#EF4444" FontSize="14" HorizontalOptions="Center"/>

            <Label Text="Your Active Loan Accounts" FontSize="18" FontAttributes="Bold" TextColor="#1E293B"/>

            <!-- Loans List -->
            <CollectionView ItemsSource="{Binding Loans}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Loan">
                        <Border StrokeShape="RoundRectangle 8" Padding="15" Margin="0,5" BackgroundColor="#F1F5F9">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding LoanType, StringFormat='{0} Loan'}" FontAttributes="Bold" FontSize="16" TextColor="#1E293B"/>
                                    <Label Text="{Binding Bank.Name, StringFormat='Bank: {0}', FallbackValue='Bank'}" FontSize="12" TextColor="#64748B"/>
                                    <Label Text="{Binding LoanNumber, StringFormat='Ref: {0}'}" FontSize="12" TextColor="#94A3B8"/>
                                    <Label Text="{Binding NextEmiDate, StringFormat='Next EMI: {0:dd MMM yyyy}'}" FontSize="12" TextColor="#F59E0B"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="0,0,15,0">
                                    <Label Text="{Binding RemainingPrincipal, StringFormat='₹{0:N0}'}" FontAttributes="Bold" FontSize="16" TextColor="#3B82F6" HorizontalOptions="End"/>
                                    <Label Text="{Binding MonthlyEmi, StringFormat='EMI: ₹{0:N0}'}" FontSize="12" TextColor="#64748B" HorizontalOptions="End"/>
                                    <Label Text="{Binding InterestRate, StringFormat='APR: {0}%'}" FontSize="11" TextColor="#94A3B8" HorizontalOptions="End"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="2" Text="Delete"
                                        Command="{Binding BindingContext.DeleteLoanCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#EF4444" TextColor="#FFFFFF" HeightRequest="36" Padding="10,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
