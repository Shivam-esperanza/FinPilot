<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FinPilot.ViewModels"
             xmlns:models="clr-namespace:FinPilot.Models"
             x:Class="FinPilot.Views.BankOffersPage"
             x:DataType="viewmodels:BankOffersViewModel"
             Title="Partner Bank Offers"
             BackgroundColor="#FFFFFF">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15" MaximumWidthRequest="550" HorizontalOptions="Center">

            <Label Text="Partner Bank Offers and Deals" FontSize="24" FontAttributes="Bold" TextColor="#512BD4"/>
            <Label Text="* Demo/partner promotional datasets stored locally" FontSize="12" TextColor="Gray"/>

            <Label Text="{Binding ErrorMessage}" TextColor="#EF4444" FontSize="14" HorizontalOptions="Center"/>

            <CollectionView ItemsSource="{Binding Offers}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Offer">
                        <Border StrokeShape="RoundRectangle 8" Padding="15" Margin="0,5" BackgroundColor="#F1F5F9">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Title}" FontAttributes="Bold" FontSize="16" TextColor="#1E293B"/>
                                    <Border Grid.Column="1" StrokeShape="RoundRectangle 4" Padding="6,2" BackgroundColor="#512BD4">
                                        <Label Text="{Binding OfferType}" FontSize="11" TextColor="#FFFFFF" FontAttributes="Bold"/>
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Description}" FontSize="13" TextColor="#475569"/>
                                <Label Text="{Binding ExpiryDate, StringFormat='Expires: {0:dd MMM yyyy}'}" FontSize="11" TextColor="#F59E0B"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
